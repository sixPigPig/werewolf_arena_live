[Unit]
Description=Werewolf Arena live-run orphan reaper
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=werewolf
Group=werewolf
WorkingDirectory=/opt/werewolf-arena/apps/api
EnvironmentFile=/etc/werewolf-arena/api.env
ExecStart=/opt/werewolf-arena/apps/api/.venv/bin/python -m app.cli run-live-run-reaper
Restart=on-failure
RestartSec=10s
TimeoutStopSec=180s
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
UMask=0077

[Install]
WantedBy=multi-user.target

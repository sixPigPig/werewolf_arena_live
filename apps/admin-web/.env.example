# Local development uses the real /api/v1/admin session and player APIs.
VITE_ADMIN_AUTH_ENABLED=true

# Show the no-input local development login button. This is ignored outside Vite DEV,
# and the API must independently enable ADMIN_DEV_AUTH_ENABLED.
VITE_ADMIN_DEV_LOGIN_ENABLED=true

# Fixture preview is opt-in and must never be used as an integration result.
VITE_ADMIN_PREVIEW_MODE=false

# Defaults to the Vite /api proxy when unset.
# VITE_API_BASE_URL=http://127.0.0.1:8000

APP_NAME=Python React Web API
APP_ENVIRONMENT=development
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/app
# Production uses the versioned PostgreSQL rule catalog and never falls back to
# the static registry. The static source is staging-only emergency compatibility.
RULE_SET_CATALOG_SOURCE=database
CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174,http://localhost:5175,http://127.0.0.1:5175
PUBLIC_CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174

# Admin authentication is fail-closed. Development login never accepts an
# identity from the request and cannot be enabled when APP_ENVIRONMENT=production.
ADMIN_DEV_AUTH_ENABLED=false
ADMIN_DEV_AUTH_EMAIL=admin@example.test
ADMIN_DEV_AUTH_DISPLAY_NAME=Development Admin
ADMIN_DEV_AUTH_ROLE=super_admin
ADMIN_SESSION_COOKIE_NAME=werewolf_admin_session
# Set false only for local HTTP development. Production validation requires true.
ADMIN_SESSION_COOKIE_SECURE=false
ADMIN_SESSION_TTL_SECONDS=28800

# Formal Admin identity uses OIDC Authorization Code + PKCE. Pre-provisioned
# users are matched by verified email once, then permanently bound to issuer/sub.
ADMIN_OIDC_ENABLED=false
ADMIN_OIDC_ISSUER_URL=
ADMIN_OIDC_CLIENT_ID=
ADMIN_OIDC_CLIENT_SECRET=
ADMIN_OIDC_REDIRECT_URI=http://127.0.0.1:8000/api/v1/admin/oidc/callback
ADMIN_OIDC_WEB_BASE_URL=http://127.0.0.1:5175
ADMIN_OIDC_CLIENT_AUTH_METHOD=client_secret_basic
ADMIN_OIDC_LOGIN_TTL_SECONDS=600

# Anonymous C-end sessions use an opaque HttpOnly cookie. Only token hashes are
# persisted by the API. Set secure=false only for local HTTP development.
PUBLIC_SESSION_COOKIE_NAME=werewolf_public_session
PUBLIC_SESSION_COOKIE_SECURE=false
PUBLIC_SESSION_TTL_SECONDS=2592000

# Temporary compatibility switch for the legacy anonymous player-profile editor.
# Disable after admin-web has taken over content management.
LEGACY_PLAYER_PROFILE_CONTENT_WRITES_ENABLED=false
# Temporary opt-in for the old global `{favorite}` PATCH. Keep disabled once
# mobile-web uses the per-viewer public favorite API.
LEGACY_PLAYER_PROFILE_FAVORITE_WRITES_ENABLED=false
# Old Web voice generation is an anonymous compatibility endpoint. Keep it
# disabled; production validation rejects enabling it.
LEGACY_JUDGE_VOICE_GENERATION_ENABLED=false

WEREWOLF_DEFAULT_MODEL=
MODEL_CATALOG_AGENT_PLAN=agent-plan
# Agent Plan model discovery uses the authenticated arkcli control-plane session.
MODEL_CATALOG_ARKCLI_PATH=arkcli
MODEL_CATALOG_SYNC_TIMEOUT_SECONDS=20
MODEL_CATALOG_DEEPSEEK_TIMEOUT_SECONDS=10
# P2 lineup gate rollout mode: observe, repair, or enforce.
WEREWOLF_LINEUP_QUALITY_MODE=repair
# P2 speech quality retry rollout switch. Reports are still recorded when false.
WEREWOLF_SPEECH_QUALITY_RETRY_ENABLED=true
# P2 action deadlines and deterministic timeout fallbacks.
WEREWOLF_ACTION_BUDGETS_ENABLED=true
WEREWOLF_REQUIRED_ACTION_REQUEST_SECONDS=12
WEREWOLF_REQUIRED_ACTION_TOTAL_SECONDS=15
WEREWOLF_REQUIRED_ACTION_BATCH_SECONDS=15
WEREWOLF_OPTIONAL_ACTION_REQUEST_SECONDS=10
WEREWOLF_OPTIONAL_ACTION_TOTAL_SECONDS=12
WEREWOLF_OPTIONAL_ACTION_BATCH_SECONDS=12
WEREWOLF_PUBLIC_SPEECH_FIRST_TOKEN_SECONDS=10
WEREWOLF_PUBLIC_SPEECH_TOTAL_SECONDS=45
WEREWOLF_PRIVATE_TEXT_FIRST_TOKEN_SECONDS=8
WEREWOLF_PRIVATE_TEXT_TOTAL_SECONDS=25
WEREWOLF_PRIVATE_TEXT_BATCH_SECONDS=25
# Agent Plan uses one API key for all models below. ARK_API_KEY is accepted as
# a compatibility alias for ARK_AGENT_PLAN_API_KEY.
ARK_AGENT_PLAN_API_KEY=
ARK_AGENT_PLAN_API_HOST=https://ark.cn-beijing.volces.com
ARK_AGENT_PLAN_BASE_URL=https://ark.cn-beijing.volces.com/api/plan/v3
ARK_AGENT_PLAN_MODELS=doubao-seed-2-0-lite-260215,glm-5-2-260617,minimax-m3
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DASHSCOPE_API_KEY=
DASHSCOPE_API_HOST=https://dashscope.aliyuncs.com
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen3.6-plus

# Live voice streaming. Keep disabled unless ARK TTS credentials are configured.
# The frontend streams PCM chunks as they arrive; use pcm/24000 unless the player
# implementation is updated for another audio format.
ARK_TTS_ENABLED=false
ARK_TTS_API_KEY=
ARK_TTS_RESOURCE_ID=seed-tts-2.0
ARK_TTS_WS_URL=wss://openspeech.bytedance.com/api/v3/plan/tts/bidirection
ARK_TTS_PLAYER_SPEAKER=zh_female_gaolengyujie_uranus_bigtts
ARK_TTS_JUDGE_SPEAKER=zh_female_vv_uranus_bigtts
ARK_TTS_AUDIO_FORMAT=pcm
ARK_TTS_SAMPLE_RATE=24000
# Persistent judge voice worker queue polling interval (0.25-60 seconds).
JUDGE_VOICE_WORKER_POLL_SECONDS=2

# Multi-instance live-run coordination. The lease must be comfortably longer
# than the heartbeat interval. Event polling is used only when a client lands
# on an API instance that does not own the run.
LIVE_RUN_LEASE_SECONDS=15
LIVE_RUN_HEARTBEAT_SECONDS=3
LIVE_RUN_EVENT_POLL_SECONDS=0.25
# Dedicated orphan reaper. Run with `python -m app.cli run-live-run-reaper`.
LIVE_RUN_REAPER_POLL_SECONDS=5
LIVE_RUN_REAPER_STALE_GRACE_SECONDS=30
LIVE_RUN_REAPER_BACKOFF_SECONDS=30
LIVE_RUN_REAPER_MAX_ATTEMPTS=3
LIVE_RUN_REAPER_HEARTBEAT_SECONDS=10
LIVE_RUN_REAPER_PROBE_MAX_AGE_SECONDS=45

# P3 terminal quality evaluation. The HMAC key protects stable issue IDs and
# must be supplied from the deployment secret whenever the worker is enabled.
QUALITY_EVALUATION_ENABLED=false
QUALITY_EVALUATION_VERSION=p3-v1
QUALITY_EVALUATION_HMAC_KEY=
QUALITY_EVALUATION_POLL_SECONDS=0.5
QUALITY_EVALUATION_LEASE_SECONDS=120
QUALITY_EVALUATION_MAX_ATTEMPTS=5
QUALITY_EVALUATION_BACKOFF_SECONDS=5
QUALITY_EVALUATION_HEARTBEAT_SECONDS=10
QUALITY_EVALUATION_PROBE_MAX_AGE_SECONDS=45
QUALITY_EVALUATION_RETENTION_DAYS=90

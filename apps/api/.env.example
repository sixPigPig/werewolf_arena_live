APP_NAME=Python React Web API
APP_ENVIRONMENT=development
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/app
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:5175,http://127.0.0.1:5175
PUBLIC_CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174

# Admin authentication is fail-closed. Development login never accepts an
# identity from the request and cannot be enabled when APP_ENVIRONMENT=production.
ADMIN_DEV_AUTH_ENABLED=false
ADMIN_DEV_AUTH_EMAIL=admin@example.test
ADMIN_DEV_AUTH_DISPLAY_NAME=Development Admin
ADMIN_DEV_AUTH_ROLE=super_admin
ADMIN_SESSION_COOKIE_NAME=werewolf_admin_session
# Set false only for local HTTP development. Production validation requires true.
ADMIN_SESSION_COOKIE_SECURE=false
ADMIN_SESSION_TTL_SECONDS=28800

# Anonymous C-end sessions use an opaque HttpOnly cookie. Only token hashes are
# persisted by the API. Set secure=false only for local HTTP development.
PUBLIC_SESSION_COOKIE_NAME=werewolf_public_session
PUBLIC_SESSION_COOKIE_SECURE=false
PUBLIC_SESSION_TTL_SECONDS=2592000

# Temporary compatibility switch for the legacy anonymous player-profile editor.
# Disable after admin-web has taken over content management.
LEGACY_PLAYER_PROFILE_CONTENT_WRITES_ENABLED=false
# Temporary opt-in for the old global `{favorite}` PATCH. Keep disabled once
# mobile-web uses the per-viewer public favorite API.
LEGACY_PLAYER_PROFILE_FAVORITE_WRITES_ENABLED=false

WEREWOLF_DEFAULT_MODEL=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
MINIMAX_API_KEY=
MINIMAX_API_HOST=https://api.minimaxi.com
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_MODEL=MiniMax-M2.7
DASHSCOPE_API_KEY=
DASHSCOPE_API_HOST=https://dashscope.aliyuncs.com
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen3.6-plus

# Live voice streaming. Keep disabled unless ARK TTS credentials are configured.
# The frontend streams PCM chunks as they arrive; use pcm/24000 unless the player
# implementation is updated for another audio format.
ARK_TTS_ENABLED=false
ARK_TTS_API_KEY=
ARK_TTS_RESOURCE_ID=seed-tts-2.0
ARK_TTS_WS_URL=wss://openspeech.bytedance.com/api/v3/plan/tts/bidirection
ARK_TTS_PLAYER_SPEAKER=zh_female_gaolengyujie_uranus_bigtts
ARK_TTS_JUDGE_SPEAKER=zh_female_vv_uranus_bigtts
ARK_TTS_AUDIO_FORMAT=pcm
ARK_TTS_SAMPLE_RATE=24000
